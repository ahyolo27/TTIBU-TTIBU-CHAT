# Build stage - compile pg_bigm
FROM postgres:15-bookworm AS builder

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential git ca-certificates postgresql-server-dev-15 \
 && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/pgbigm/pg_bigm.git /tmp/pg_bigm \
 && make -C /tmp/pg_bigm USE_PGXS=1 \
 && make -C /tmp/pg_bigm USE_PGXS=1 install \
 && rm -rf /tmp/pg_bigm

# Runtime stage
FROM postgres:15-bookworm

# Copy compiled extension files from builder stage.
COPY --from=builder /usr/share/postgresql/15/extension/pg_bigm* /usr/share/postgresql/15/extension/
COPY --from=builder /usr/lib/postgresql/15/lib/pg_bigm.so /usr/lib/postgresql/15/lib/

# Initialize app extensions and LiteLLM database on first database boot.
RUN mkdir -p /docker-entrypoint-initdb.d \
 && printf '%s\n' \
      '#!/usr/bin/env bash' \
      'set -e' \
      '' \
      'psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" <<-EOSQL' \
      '  CREATE EXTENSION IF NOT EXISTS pg_bigm;' \
      'EOSQL' \
      '' \
      'if ! psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres -tAc "SELECT 1 FROM pg_database WHERE datname = '\''litellm_db'\''" | grep -q 1; then' \
      '  psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres <<-EOSQL' \
      '    CREATE DATABASE litellm_db;' \
      'EOSQL' \
      'fi' \
      > /docker-entrypoint-initdb.d/001_init_databases.sh \
 && chmod +x /docker-entrypoint-initdb.d/001_init_databases.sh
